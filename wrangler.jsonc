{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "pack",
  "compatibility_date": "2026-10-01",
  // Static site only: Cloudflare serves the Vite build and falls back to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Branch previews. Nothing differs from production for a static site.
  "previews": {},
}
